{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handheld-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/covers/*", "/themes/*", "/api/*"] },
  // Mídia pesada (capas) fica no R2, fora do limite de 20 mil arquivos dos assets (public/.assetsignore).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gamehub-media" }],
  // Favoritos e listas ("Quero jogar", "Zerei") por usuário do Access, iguais em todos os aparelhos.
  "vars": { "RA_USER": "guconstantino" },
  "kv_namespaces": [{ "binding": "LISTS", "id": "b2706d894aab4865ad838f3f1b460d2f" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamehub",
      "database_id": "883b5d24-aee4-4804-8237-16bcba0d5170",
      "migrations_dir": "migrations"
    }
  ],
  // Só o domínio próprio, que fica atrás do Cloudflare Access (só o e-mail do Gustavo).
  // workers.dev e preview URLs desligados para não haver caminho sem login.
  "routes": [{ "pattern": "gamehub.gustavoconstantino.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
