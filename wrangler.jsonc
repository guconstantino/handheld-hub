{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handheld-hub",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamehub",
      // Só local por enquanto. Na ida para produção: `wrangler d1 create gamehub` e trocar este id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Produção (ainda não): "routes": [{ "pattern": "gamehub.gustavoconstantino.com", "custom_domain": true }]
  // + Cloudflare Access na frente (só o e-mail do Gustavo).
}
