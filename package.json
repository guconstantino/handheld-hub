{
  "name": "handheld-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply gamehub --local",
    "scan:s20": "python3 scanner/scan.py s20-sd s20-int",
    "scan:drive": "python3 scanner/scan.py drive-plataform",
    "devices": "python3 scanner/scan.py --devices",
    "build:static": "python3 scripts/build_static.py",
    "scan:miyoo": "python3 scanner/scan.py miyoo-sd",
    "scan:switch": "python3 scanner/scan.py switch-jksv"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  }
}
